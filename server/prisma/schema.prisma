// Prisma schema for Counter POS System connected to Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  CARD
  QRPH
  OTHER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  WITHDRAWAL
  CASH_IN
}

enum MovementType {
  SALE
  RESTOCK
  RETURN
  MANUAL_ADJUSTMENT
  DAMAGE
  EXPIRED
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  fullName           String
  email              String?             @unique
  passwordHash       String
  role               Role                @default(CASHIER)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  sales              Sale[]              @relation("CashierSales")
  inventoryMovements InventoryMovement[]
  refunds            Refund[]
  auditLogs          AuditLog[]
  cashSessions       CashSession[]       @relation("CashSessions")
  cashMovements      CashMovement[]

  @@map("users")
}

model AuthorizedDevice {
  id           String    @id @default(uuid())
  deviceKey    String    @unique
  name         String
  isAuthorized Boolean   @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isAuthorized])
  @@map("authorized_devices")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id             String              @id @default(uuid())
  name           String
  sku            String              @unique
  barcode        String              @unique
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description    String?
  costPrice      Decimal             @db.Decimal(12, 2)
  sellingPrice   Decimal             @db.Decimal(12, 2)
  stockQuantity  Decimal             @default(0) @db.Decimal(12, 3)
  minStockLevel  Decimal             @default(5) @db.Decimal(12, 3)
  unit           String              @default("pcs")
  buyOneTakeOne  Boolean             @default(false)
  taxRate        Decimal             @default(0.00) @db.Decimal(5, 2)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  saleItems      SaleItem[]
  inventoryMoves InventoryMovement[]
  loyaltyReward  LoyaltyReward?

  @@index([barcode])
  @@index([sku])
  @@index([name])
  @@map("products")
}

model Customer {
  id                  String               @id @default(uuid())
  phone               String               @unique
  fullName            String?
  pointsBalance       Int                  @default(0)
  totalSpent          Decimal              @default(0.00) @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  sales               Sale[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyRedemptions  LoyaltyRedemption[]

  @@index([phone])
  @@map("customers")
}

model LoyaltyTransaction {
  id         String   @id @default(uuid())
  customerId String
  saleId     String?
  type       String
  points     Int
  amount     Decimal? @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([saleId])
  @@map("loyalty_transactions")
}

model LoyaltyReward {
  id          String   @id @default(uuid())
  productId   String   @unique
  pointsCost  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  redemptions LoyaltyRedemption[]

  @@map("loyalty_rewards")
}

model LoyaltyRedemption {
  id          String   @id @default(uuid())
  customerId  String
  rewardId    String
  pointsSpent Int
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward   LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("loyalty_redemptions")
}

model Sale {
  id                 String              @id @default(uuid())
  transactionNumber  String              @unique
  offlineId          String?             @unique
  cashierId          String
  cashier            User                @relation("CashierSales", fields: [cashierId], references: [id])
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal           Decimal             @db.Decimal(12, 2)
  itemDiscountTotal  Decimal             @default(0.00) @db.Decimal(12, 2)
  orderDiscountTotal Decimal             @default(0.00) @db.Decimal(12, 2)
  taxTotal           Decimal             @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal             @db.Decimal(12, 2)
  amountTendered     Decimal             @db.Decimal(12, 2)
  changeDue          Decimal             @default(0.00) @db.Decimal(12, 2)
  paymentMethod      PaymentMethod       @default(CASH)
  paymentReference   String?
  status             SaleStatus          @default(COMPLETED)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items              SaleItem[]
  payments           Payment[]
  refunds            Refund[]
  inventoryMoves     InventoryMovement[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([transactionNumber])
  @@index([createdAt])
  @@index([cashierId])
  @@map("sales")
}

model SaleItem {
  id           String    @id @default(uuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  productName  String
  sku          String
  barcode      String
  unitPrice    Decimal   @db.Decimal(12, 2)
  costPrice    Decimal   @db.Decimal(12, 2)
  quantity     Decimal   @db.Decimal(12, 3)
  freeQuantity Decimal   @default(0) @db.Decimal(12, 3)
  stockQuantity Decimal  @default(0) @db.Decimal(12, 3)
  discount     Decimal   @default(0.00) @db.Decimal(12, 2)
  lineTotal    Decimal   @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  referenceNo   String?
  createdAt     DateTime      @default(now())

  @@index([saleId])
  @@map("payments")
}

model InventoryMovement {
  id           String        @id @default(uuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         MovementType
  quantity     Decimal   @db.Decimal(12, 3)
  balanceAfter Decimal   @db.Decimal(12, 3)
  reason       String?
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  saleId       String?
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Refund {
  id             String        @id @default(uuid())
  refundNumber   String        @unique
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  reason         String
  restockItems   Boolean       @default(true)
  itemsJson      Json
  createdAt      DateTime      @default(now())

  @@index([saleId])
  @@index([refundNumber])
  @@map("refunds")
}

model StoreSettings {
  id             String    @id @default(uuid())
  storeName      String    @default("MONA")
  storeAddress   String    @default("123 Market Avenue, Metro Manila")
  phone          String    @default("+63 912 345 6789")
  taxRate        Decimal   @default(0.00) @db.Decimal(5, 2)
  currencySymbol String    @default("₱")
  receiptFooter  String    @default("Thank you for shopping with us! Please come again.")
  receiptPaperWidth String @default("80mm")
  loyaltyPointsPerHundred Decimal @default(1.00) @db.Decimal(8, 2)
  systemActive Boolean @default(true)
  maxProducts Int @default(0)
  maxCustomers Int @default(0)
  maxLoyaltyRewards Int @default(0)
  updatedAt      DateTime  @updatedAt

  @@map("store_settings")
}

model AuditLog {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model CashSession {
  id            String            @id @default(uuid())
  cashierId     String
  cashier       User              @relation("CashSessions", fields: [cashierId], references: [id])
  openingCash   Decimal           @db.Decimal(12, 2)
  closingCash   Decimal?          @db.Decimal(12, 2)
  expectedCash  Decimal?          @db.Decimal(12, 2)
  variance      Decimal?          @db.Decimal(12, 2)
  status        CashSessionStatus @default(OPEN)
  notes         String?
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  movements     CashMovement[]

  @@index([cashierId, status])
  @@index([openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id          String            @id @default(uuid())
  sessionId   String
  session     CashSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  type        CashMovementType
  amount      Decimal           @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@map("cash_movements")
}
